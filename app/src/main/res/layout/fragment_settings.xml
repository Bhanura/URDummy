<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Screen Title -->
        <TextView
            android:id="@+id/notifications_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textStyle="bold"
            android:textSize="24sp"
            android:gravity="start"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Notification Method -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notification_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_notification_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Method"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/help_notification_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose how you want to receive alerts."
                    android:textSize="14sp"
                    android:alpha="0.8"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_push"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Push Notifications" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_sms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SMS Notifications" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Notifications" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notification Type -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notification_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_notification_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Type"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/help_notification_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select the alerts you want to receive."
                    android:textSize="14sp"
                    android:alpha="0.8"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_daily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daily Care Reminder" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_weather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weather-Based Alerts" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_harvest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harvest Time Reminders" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reminder Time Preference -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_reminder_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminder Time"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/help_reminder_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pick a preferred time to receive daily reminders."
                    android:textSize="14sp"
                    android:alpha="0.8"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/selected_time_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not set"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pick_time_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose time"
                        android:textAllCaps="false"
                        android:minHeight="40dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="?attr/colorOnPrimary"
                        app:backgroundTint="?attr/colorPrimary"
                        app:rippleColor="?attr/colorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>