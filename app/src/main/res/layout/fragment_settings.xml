<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0E3C8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">



        </LinearLayout>

        <!-- Notification Method -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#8AA46C"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Method"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_push"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Push Notifications"
                        android:textColor="@android:color/white" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_sms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SMS Notifications"
                        android:textColor="@android:color/white" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email Notifications"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Notification Type -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#8AA46C"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Type"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_daily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Daily Care Reminder"
                        android:textColor="@android:color/white" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_weather"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Weather-Based Alerts"
                        android:textColor="@android:color/white" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_harvest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Harvest Time Reminders"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Reminder Time Preference -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#8AA46C"
            android:elevation="4dp">


        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
